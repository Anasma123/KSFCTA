{
  "version": 2,
  "builds": [
    {
      "src": "ksfcta_project/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.11",
        "includeFiles": [
          "db.sqlite3",
          "membership/templates/**",
          "static/**",
          "staticfiles/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "ksfcta_project/wsgi.py"
    }
  ]
}
